<UserControl x:Class="Attendance_System.Views.ShiftSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Shift Settings" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Applies to every staff member. Changes take effect on the next tap — no restart needed."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Daily schedule" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Times are Philippine Standard Time." Style="{StaticResource HelpTextStyle}" Margin="0,2,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Shift start" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbShiftStart" Style="{StaticResource ModernComboBoxStyle}"
                                  DisplayMemberPath="Label" MaxDropDownHeight="280" SelectionChanged="Time_SelectionChanged"/>
                        <TextBlock Text="When the workday officially begins." Style="{StaticResource HelpTextStyle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Late after" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbLateCutoff" Style="{StaticResource ModernComboBoxStyle}"
                                  DisplayMemberPath="Label" MaxDropDownHeight="280" SelectionChanged="Time_SelectionChanged"/>
                        <TextBlock Text="A TIME-IN after this is labelled Late." Style="{StaticResource HelpTextStyle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Absent after" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbAbsentCutoff" Style="{StaticResource ModernComboBoxStyle}"
                                  DisplayMemberPath="Label" MaxDropDownHeight="280" SelectionChanged="Time_SelectionChanged"/>
                        <TextBlock Text="No TIME-IN by this time counts as absent. (Not enforced yet.)"
                                   Style="{StaticResource HelpTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Plain-language preview of the rules being saved -->
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusControl}"
                        Padding="14,12" Margin="0,22,0,0">
                    <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <Border Style="{StaticResource SectionDividerStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="BtnRevert" Grid.Column="1" Content="Discard changes" Style="{StaticResource SubtleButtonStyle}"
                            Margin="0,0,8,0" IsEnabled="False" Click="Revert_Click"/>
                    <Button x:Name="BtnSave" Grid.Column="2" Content="Save settings" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False" Click="Save_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
