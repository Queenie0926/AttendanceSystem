<Window x:Class="Attendance_System.Views.StaffEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit staff" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Assets/staffly.ico"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource FontFamilyBase}">

    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTitle" Text="Edit staff" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
        <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,20"/>

        <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="First name" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtFirstName" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}">
                        <Run Text="Middle name"/><Run Text="  (optional)" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}"/>
                    </TextBlock>
                    <TextBox x:Name="TxtMiddleName" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="Last name" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtLastName" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Email address" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4">
                    <TextBlock Text="RFID UID" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtRfidUid" Style="{StaticResource ModernTextBoxStyle}" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Department" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbDepartment" Style="{StaticResource ModernComboBoxStyle}"
                              Tag="Select department" SelectionChanged="CmbDepartment_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="Program" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbProgram" Style="{StaticResource ModernComboBoxStyle}" Tag="Select program"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="4">
                    <TextBlock Text="Position" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbPosition" Style="{StaticResource ModernComboBoxStyle}" Tag="Select position"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shift" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="TxtShiftHelp" Style="{StaticResource HelpTextStyle}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbShiftMode" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                              VerticalAlignment="Center" SelectionChanged="CmbShiftMode_SelectionChanged">
                        <ComboBoxItem Content="Default shift"/>
                        <ComboBoxItem Content="Custom shift"/>
                    </ComboBox>
                </Grid>

                <Grid x:Name="CustomShiftPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Shift start" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbShiftStart" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="Label" MaxDropDownHeight="240"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Late after" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbLateCutoff" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="Label" MaxDropDownHeight="240"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Absent after" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbAbsentCutoff" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="Label" MaxDropDownHeight="240"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource DangerBrush}"/>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="BtnSave" Grid.Column="2" Content="Save changes" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </Grid>
    </StackPanel>
</Window>
