<UserControl x:Class="Attendance_System.Views.EnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="4" Height="26" Background="#FFCF0A2C" CornerRadius="2" Margin="0,0,10,0"/>
            <TextBlock Text="Staff Enrollment" Style="{StaticResource SectionTitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtFirstName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="MIDDLE NAME (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtMiddleName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLastName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="EMAIL (FOR OTP DELIVERY)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="RFID UID" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtRfidUid" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DEPARTMENT" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbDepartment" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,16"
                                  SelectionChanged="CmbDepartment_SelectionChanged"/>

                        <TextBlock Text="PROGRAM" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbProgram" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="POSITION" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbPosition" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Grid>

                <Separator Background="#F0F1F3" Margin="0,20,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#6B7280" FontSize="12"/>
                    <Button Content="Enroll Staff" Style="{StaticResource PrimaryButtonStyle}" Click="EnrollButton_Click" Width="140"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22,18,22,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Enrolled Staff" FontWeight="Bold" FontSize="15" Foreground="#1F2937"/>
                </StackPanel>
                <DataGrid x:Name="StaffGrid" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="1.6*"/>
                        <DataGridTextColumn Header="PROGRAM" Binding="{Binding Program}" Width="1.8*"/>
                        <DataGridTextColumn Header="POSITION" Binding="{Binding PositionRole}" Width="1.2*"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.8*"/>
                        <DataGridTextColumn Header="RFID UID" Binding="{Binding RfidUid}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
