<UserControl x:Class="Attendance_System.Views.EnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Staffs" Style="{StaticResource PageTitleStyle}"/>
               
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                    Click="EnrollButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Width="11" Height="11" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 5 0 V 10 M 0 5 H 10"/>
                    <TextBlock Text="Enroll staff" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="24,20,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="All staff" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource CountChipStyle}">
                            <TextBlock x:Name="TxtCount" Style="{StaticResource CountChipTextStyle}" Text="0"/>
                        </Border>
                    </StackPanel>

                    <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource SearchBoxStyle}"
                             Tag="Search name, email, RFID…" TextChanged="Search_TextChanged"
                             AutomationProperties.Name="Search staff"/>

                    <ComboBox x:Name="CmbProgramFilter" Grid.Column="3" Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="ProgramFilter_SelectionChanged" AutomationProperties.Name="Filter by program"/>
                </Grid>

                <DataGrid x:Name="StaffGrid" Grid.Row="1" Style="{StaticResource ModernDataGridStyle}"
                          MouseDoubleClick="StaffGrid_MouseDoubleClick" KeyDown="StaffGrid_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="NAME" Width="2.2*" SortMemberPath="LastName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource AvatarStyle}" Content="{Binding FullName}"/>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Email}" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PROGRAM" Binding="{Binding Program}" Width="1.5*"/>
                        <DataGridTextColumn Header="POSITION" Binding="{Binding PositionRole}" Width="1.25*"/>
                        <DataGridTemplateColumn Header="SHIFT" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ShiftDisplay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RFID UID" Binding="{Binding RfidUid}" Width="0.9*" FontFamily="Consolas"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="120" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RowActionButtonStyle}" Click="EditRow_Click"
                                                ToolTip="Edit" AutomationProperties.Name="Edit staff">
                                            <!-- pencil -->
                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M 11 1.5 L 14.5 5 L 5 14.5 H 1.5 V 11 Z M 9 3.5 L 12.5 7"/>
                                        </Button>
                                        <Button Style="{StaticResource RowDangerButtonStyle}" Click="RemoveRow_Click" Margin="8,0,0,0"
                                                ToolTip="Remove" AutomationProperties.Name="Remove staff">
                                            <!-- trash -->
                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M 1 3.5 H 15 M 5.5 3.5 V 1.5 H 10.5 V 3.5 M 3 3.5 L 4 15 H 12 L 13 3.5 M 6.5 6.5 V 12 M 9.5 6.5 V 12"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding HasItems, ElementName=StaffGrid, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock x:Name="TxtEmptyTitle" Text="No staff enrolled yet" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEmptyHelp" Text="Select Enroll staff to register someone and link their RFID card."
                               Style="{StaticResource HelpTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,12,24,16" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
