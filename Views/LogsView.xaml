<UserControl x:Class="Attendance_System.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="4" Height="26" Background="#FFCF0A2C" CornerRadius="2" Margin="0,0,10,0"/>
            <TextBlock Text="Attendance Logs" Style="{StaticResource SectionTitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="FROM" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DateFrom" Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="TO" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DateTo" Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="STAFF NAME" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtStaffFilter" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Time In"/>
                            <ComboBoxItem Content="Time Out"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Button Content="Apply Filter" Style="{StaticResource PrimaryButtonStyle}" Width="130"
                        HorizontalAlignment="Right" Margin="0,16,0,0" Click="FilterButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22,18,22,8">
            <DataGrid x:Name="LogsGrid" Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STAFF NAME" Binding="{Binding StaffName}" Width="2*"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>