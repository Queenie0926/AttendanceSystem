<UserControl x:Class="Attendance_System.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Attendance Logs" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Every verified tap, with TIME-IN / TIME-OUT decided by the server."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="From" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DateFrom" Style="{StaticResource ModernDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="To" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DateTo" Style="{StaticResource ModernDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Staff name" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtStaffFilter" Style="{StaticResource ModernTextBoxStyle}" KeyDown="TxtStaffFilter_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Time In"/>
                        <ComboBoxItem Content="Time Out"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Reset" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,2" Click="ResetButton_Click"/>
                    <Button x:Name="BtnApply" Content="Apply filters" Style="{StaticResource PrimaryButtonStyle}" Click="FilterButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,18,24,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Events" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusBadge}"
                                Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Items.Count, ElementName=LogsGrid}" FontSize="{StaticResource FontSizeSmall}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LoadingText" Text="Loading…" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource HelpTextStyle}" Visibility="Collapsed"/>
                </Grid>

                <DataGrid x:Name="LogsGrid" Grid.Row="1" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STAFF NAME" Binding="{Binding StaffName}" Width="2*"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="TIME" Binding="{Binding TimeDisplay}" Width="1*"/>
                        <DataGridTemplateColumn Header="STATUS" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeStyle}"
                                            Background="{Binding Converter={StaticResource StatusBadgeFill}}">
                                        <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{Binding Converter={StaticResource StatusBadgeText}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding HasItems, ElementName=LogsGrid, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No attendance events" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Taps verified on the terminal will show up here. Try widening the date range."
                               Style="{StaticResource HelpTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
