<UserControl x:Class="Attendance_System.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Daily Time Records" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Pair each day's TIME-IN and TIME-OUT into payroll-ready rows, then export."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="From" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DateFrom" Style="{StaticResource ModernDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="To" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DateTo" Style="{StaticResource ModernDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}">
                        <Run Text="Staff name"/><Run Text="  (optional)" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}"/>
                    </TextBlock>
                    <TextBox x:Name="TxtStaffFilter" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnExport" Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" IsEnabled="False" Click="ExportButton_Click"/>
                    <Button x:Name="BtnGenerate" Content="Generate DTR" Style="{StaticResource PrimaryButtonStyle}"
                            Click="GenerateButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,18,24,14">
                    <TextBlock Text="Report" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusBadge}"
                            Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, ElementName=DtrGrid}" FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <DataGrid x:Name="DtrGrid" Grid.Row="1" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STAFF NAME" Binding="{Binding StaffName}" Width="2*"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="1.1*"/>
                        <DataGridTextColumn Header="TIME IN" Binding="{Binding TimeIn}" Width="1*"/>
                        <DataGridTextColumn Header="TIME OUT" Binding="{Binding TimeOut}" Width="1*"/>
                        <DataGridTextColumn Header="HOURS" Binding="{Binding HoursWorked}" Width="1*"/>
                        <DataGridTemplateColumn Header="REMARKS" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeStyle}" Background="{StaticResource WarnSoftBrush}"
                                            Visibility="{Binding IsLate, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Late" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding HasItems, ElementName=DtrGrid, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No report generated" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a date range and select Generate DTR."
                               Style="{StaticResource HelpTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
