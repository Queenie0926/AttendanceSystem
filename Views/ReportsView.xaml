<UserControl x:Class="Attendance_System.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Attendance_System.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Daily Time Records" Style="{StaticResource PageTitleStyle}"/>
                
            </StackPanel>
            <Button x:Name="BtnExport" Grid.Column="1" Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center" IsEnabled="False" Click="ExportButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,20,24,12">
                    <TextBlock Text="Report" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Style="{StaticResource CountChipStyle}">
                        <TextBlock Text="{Binding Items.Count, ElementName=DtrGrid}" Style="{StaticResource CountChipTextStyle}"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="24,0,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtStaffFilter" Style="{StaticResource SearchBoxStyle}" Tag="Staff name (optional)"
                             KeyDown="TxtStaffFilter_KeyDown" AutomationProperties.Name="Staff name"/>
                    <DatePicker x:Name="DateFrom" Grid.Column="2" Style="{StaticResource ModernDatePickerStyle}"
                                h:DatePickerWatermark.Text="From date" ToolTip="From date" AutomationProperties.Name="From date"/>
                    <DatePicker x:Name="DateTo" Grid.Column="4" Style="{StaticResource ModernDatePickerStyle}"
                                h:DatePickerWatermark.Text="To date" ToolTip="To date" AutomationProperties.Name="To date"/>
                    <Button x:Name="BtnGenerate" Grid.Column="6" Content="Generate DTR" Style="{StaticResource PrimaryButtonStyle}"
                            Click="GenerateButton_Click"/>
                </Grid>

                <DataGrid x:Name="DtrGrid" Grid.Row="2" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STAFF" Width="2*" SortMemberPath="StaffName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource AvatarStyle}" Content="{Binding StaffName}"/>
                                        <TextBlock Text="{Binding StaffName}" FontWeight="SemiBold" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="1.1*"/>
                        <DataGridTextColumn Header="TIME IN" Binding="{Binding TimeIn}" Width="1*"/>
                        <DataGridTextColumn Header="TIME OUT" Binding="{Binding TimeOut}" Width="1*"/>
                        <DataGridTextColumn Header="HOURS" Binding="{Binding HoursWorked}" Width="1*"/>
                        <DataGridTemplateColumn Header="REMARKS" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeStyle}" Background="{StaticResource WarnSoftBrush}"
                                            Visibility="{Binding IsLate, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Late" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding HasItems, ElementName=DtrGrid, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No report generated" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a date range and select Generate DTR."
                               Style="{StaticResource HelpTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
