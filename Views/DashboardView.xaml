<UserControl x:Class="Attendance_System.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="KpiNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource HelpTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GridLineStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="AxisLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HelpTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/>
                
            </StackPanel>
            <TextBlock x:Name="TxtUpdated" Grid.Column="1" Style="{StaticResource HelpTextStyle}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="BtnRefresh" Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center" Click="Refresh_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- ── Headline numbers ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total staff" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding TotalStaff, FallbackValue=—}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="Enrolled with an RFID card" Style="{StaticResource KpiNoteStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Present today" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Style="{StaticResource KpiValueStyle}">
                                <Run Text="{Binding PresentToday, Mode=OneWay, FallbackValue=—}"/><Run
                                     Text="{Binding TotalStaff, Mode=OneWay, StringFormat=' / {0}', FallbackValue=''}"
                                     FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                            </TextBlock>
                            <!-- progress toward everyone in -->
                            <Grid Height="6" Margin="0,4,0,8">
                                <Border Background="{StaticResource InputBrush}" CornerRadius="3"/>
                                <Border x:Name="PresentBar" Background="{StaticResource PrimaryBrush}" CornerRadius="3"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock Text="{Binding PresentRateText, FallbackValue=''}" Style="{StaticResource KpiNoteStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Late today" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding LateToday, FallbackValue=—}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{Binding LateRateText, FallbackValue=''}" Style="{StaticResource KpiNoteStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Taps today" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding TapsToday, FallbackValue=—}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{Binding OnSiteText, FallbackValue=''}" Style="{StaticResource KpiNoteStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Chart + recent activity ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Attendance, last 7 days" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Staff who timed in each day" Style="{StaticResource HelpTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="On time" Style="{StaticResource HelpTextStyle}" Margin="6,0,16,0" VerticalAlignment="Center"/>
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Late" Style="{StaticResource HelpTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <!-- 180 = DashboardStats.ChartPlotHeight; the extra 22 leaves room for value labels -->
                                    <RowDefinition Height="202"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- gridlines at 0, ¼, ½, ¾ and full scale -->
                                <Canvas x:Name="AxisLabels" Grid.Column="0"/>
                                <Canvas x:Name="GridLines" Grid.Column="1"/>

                                <ItemsControl x:Name="WeekBars" Grid.Column="1" ItemsSource="{Binding Week}" Margin="0,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="30"
                                                        ToolTip="{Binding ToolTipText}" Background="Transparent">
                                                <TextBlock Text="{Binding Present}" HorizontalAlignment="Center" Margin="0,0,0,4"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Height="{Binding LateHeight}" Background="{StaticResource AccentBrush}"
                                                        CornerRadius="6,6,0,0"/>
                                                <Border Height="{Binding OnTimeHeight}" Background="{StaticResource PrimaryBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <!-- no late segment on top: round this bar instead -->
                                                                <DataTrigger Binding="{Binding Late}" Value="0">
                                                                    <Setter Property="CornerRadius" Value="6,6,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Week}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DateLabel}" HorizontalAlignment="Center"
                                                           Style="{StaticResource HelpTextStyle}" FontSize="{StaticResource FontSizeLabel}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="24,24,24,12">
                                <TextBlock Text="Recent activity" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Latest taps on the terminal" Style="{StaticResource HelpTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ItemsControl x:Name="RecentList" Grid.Row="1" ItemsSource="{Binding RecentActivity}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="24,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource AvatarStyle}" Content="{Binding StaffName}"
                                                            Width="32" Height="32" FontSize="11"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StaffName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Style="{StaticResource HelpTextStyle}">
                                                    <Run Text="{Binding RelativeDateDisplay, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource BadgeStyle}"
                                                    Background="{Binding Converter={StaticResource StatusBadgeFill}}">
                                                <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{Binding Converter={StaticResource StatusBadgeText}}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="RecentEmpty" Grid.Row="1" Margin="24,8,24,24" Visibility="Collapsed">
                                <TextBlock Text="No taps in the last 7 days" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Verified taps from the RFID terminal will show up here." Style="{StaticResource HelpTextStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
