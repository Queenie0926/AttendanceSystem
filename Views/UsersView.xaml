<UserControl x:Class="Attendance_System.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Users" Style="{StaticResource PageTitleStyle}"/>
                
            </StackPanel>
            <Button x:Name="BtnRefresh" Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center" Click="Refresh_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,20,24,16">
                    <TextBlock Text="Accounts" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Style="{StaticResource CountChipStyle}">
                        <TextBlock Text="{Binding Items.Count, ElementName=UsersGrid}" Style="{StaticResource CountChipTextStyle}"/>
                    </Border>
                    <TextBlock x:Name="LoadingText" Text="Loading…" VerticalAlignment="Center" Margin="12,0,0,0"
                               Style="{StaticResource HelpTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <DataGrid x:Name="UsersGrid" Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" RowHeight="64">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ACCOUNT" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource AvatarStyle}" Content="{Binding Email}"/>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="You" Style="{StaticResource HelpTextStyle}"
                                                       Visibility="{Binding IsCurrentUser, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="FULL NAME" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,16,0" VerticalAlignment="Center"
                                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ROLE" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,16,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanEditRole}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,16,0"
                                            VerticalAlignment="Center" IsEnabled="{Binding IsDirty}" Click="SaveRow_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0"
                            Visibility="{Binding HasItems, ElementName=UsersGrid, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No users" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Accounts added in Supabase get a profile automatically." Style="{StaticResource HelpTextStyle}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,12,24,16" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="admin — everything, including users and shift settings  ·  hr — staff enrollment, logs, reports  ·  viewer — logs and reports only"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
