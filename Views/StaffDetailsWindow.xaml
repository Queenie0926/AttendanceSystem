<Window x:Class="Attendance_System.Views.StaffDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff details" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Assets/staffly.ico"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource FontFamilyBase}">

    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <!-- Header: initials avatar + name + role -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource PrimaryBrush}">
                <TextBlock x:Name="TxtInitials" FontFamily="{StaticResource FontFamilyDisplay}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFullName" Style="{StaticResource PageTitleStyle}" FontSize="19" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRole" Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="20,20,20,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Department" Style="{StaticResource DetailLabel}"/>
                    <TextBlock x:Name="TxtDepartment" Style="{StaticResource DetailValue}"/>

                    <TextBlock Text="Program" Style="{StaticResource DetailLabel}"/>
                    <TextBlock x:Name="TxtProgram" Style="{StaticResource DetailValue}"/>

                    <TextBlock Text="Enrolled" Style="{StaticResource DetailLabel}"/>
                    <TextBlock x:Name="TxtEnrolled" Style="{StaticResource DetailValue}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" Style="{StaticResource DetailLabel}"/>
                    <TextBlock x:Name="TxtEmail" Style="{StaticResource DetailValue}"/>

                    <TextBlock Text="RFID UID" Style="{StaticResource DetailLabel}"/>
                    <TextBlock x:Name="TxtRfid" Style="{StaticResource DetailValue}" FontFamily="Consolas"/>

                    <TextBlock Text="Last activity" Style="{StaticResource DetailLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border x:Name="LastBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtLastStatus" Style="{StaticResource BadgeTextStyle}"/>
                        </Border>
                        <TextBlock x:Name="TxtLastActivity" FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="Loading…"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                Margin="0,20,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
</Window>
