<Window x:Class="Attendance_System.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — Staff Attendance" Height="520" Width="860"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Assets/staffly.ico"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource FontFamilyBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="40">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Image Source="{StaticResource LogoMark}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock Text="Staffly" FontFamily="{StaticResource FontFamilyDisplay}" FontSize="18"
                               FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Tap. Verify. Recorded."
                               FontFamily="{StaticResource FontFamilyDisplay}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="RFID card plus a one-time email code keeps every attendance record honest, and the server always decides TIME-IN or TIME-OUT."
                               FontSize="13" Foreground="{StaticResource SidebarMutedTextBrush}"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <StackPanel Width="320" VerticalAlignment="Center">
                <TextBlock Text="Sign in" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Use the account your administrator created for you." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,28"/>

                <TextBlock Text="Email address" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource ModernPasswordBoxStyle}" KeyDown="TxtPassword_KeyDown"/>

                <TextBlock x:Name="StatusText" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" Margin="0,10,0,14" MinHeight="16"/>

                <Button x:Name="BtnLogin" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}"
                        Height="42" HorizontalAlignment="Stretch" Click="BtnLogin_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
