<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:h="clr-namespace:Attendance_System.Helpers">

    <!--
        Design tokens.

        Palette (MP086): Yoghurt Brulee (canvas) / Rum Chocolate (shell) /
        Ginshu (actions) / Vivid Orange Peel (accent) / Frozen Tomato (hover).

        Orange Peel is bright, so it is never a text-on-light colour — it marks
        active nav on the dark shell, focus rings and highlights. Ginshu
        carries primary actions because white text on it passes contrast (5.9:1).
    -->

    <!-- Canvas & surfaces -->
    <SolidColorBrush x:Key="CanvasBrush"       Color="#F7F2EC"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FAF6F1"/>
    <SolidColorBrush x:Key="InputBrush"        Color="#F7F2EC"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#EFE7DD"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#DDD0C0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#450E15"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B4A45"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#957A72"/>

    <!-- Primary actions (Ginshu) -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#BC2D29"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#CC3B31"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#9A2320"/>
    <SolidColorBrush x:Key="PrimarySoftBrush"    Color="#FBE6E1"/>

    <!-- Accent (Vivid Orange Peel) -->
    <SolidColorBrush x:Key="AccentBrush"       Color="#FFA102"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#DD5533"/>
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#FFF0D6"/>

    <!-- Shell (Rum Chocolate) -->
    <SolidColorBrush x:Key="SidebarBrush"          Color="#450E15"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"     Color="#5A1A20"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"    Color="#62222A"/>
    <SolidColorBrush x:Key="SidebarTextBrush"      Color="#F5E9CE"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#C4A89A"/>

    <!-- Status: colour is always paired with a text label, never used alone -->
    <SolidColorBrush x:Key="SuccessBrush"     Color="#3D5A12"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EDF7D2"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="#8A5206"/>
    <SolidColorBrush x:Key="WarnSoftBrush"    Color="#FFF0D6"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#9A2320"/>
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#FBE6E1"/>
    <SolidColorBrush x:Key="NeutralBrush"     Color="#432E6F"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#ECE8F3"/>

    <!-- Typography: Segoe UI Variable is native on Windows 11 -->
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyBase">Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeLabel">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizePage">26</sys:Double>

    <!-- Geometry -->
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">18</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">11</CornerRadius>
    <sys:Double x:Key="ControlHeight">40</sys:Double>

    <!-- Converters -->
    <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <h:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <h:StatusBadgeBrushConverter x:Key="StatusBadgeFill" Foreground="False"/>
    <h:StatusBadgeBrushConverter x:Key="StatusBadgeText" Foreground="True"/>
    <h:InitialsConverter x:Key="Initials"/>
    <h:AvatarBrushConverter x:Key="AvatarBrush"/>

</ResourceDictionary>
