<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:h="clr-namespace:Attendance_System.Helpers">

    <!--
        Design tokens.

        Palette: Linen Cream (canvas) / Forest Black (shell) / Pine Teal
        (actions) / Citron Green (accent).

        Citron is pale, so it is never a button fill — it marks active nav,
        selected rows and on-time badges only (~10% of the interface). Pine
        Teal carries primary actions because white text on it passes contrast.
    -->

    <!-- Canvas & surfaces -->
    <SolidColorBrush x:Key="CanvasBrush"       Color="#FEF8F0"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FAF6F0"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#E8E1D7"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D6CCBF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#092122"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5A5A"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#7C8A89"/>

    <!-- Primary actions (Pine Teal) -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#235354"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#2C6667"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1A4041"/>
    <SolidColorBrush x:Key="PrimarySoftBrush"    Color="#E8F0EF"/>

    <!-- Accent (Citron Green) -->
    <SolidColorBrush x:Key="AccentBrush"       Color="#E2F3A9"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#C9E37A"/>
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#F2F9DE"/>

    <!-- Shell (Forest Black) -->
    <SolidColorBrush x:Key="SidebarBrush"          Color="#092122"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"     Color="#16302F"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"    Color="#1C3635"/>
    <SolidColorBrush x:Key="SidebarTextBrush"      Color="#E9EFE6"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#8C9B98"/>

    <!-- Status: colour is always paired with a text label, never used alone -->
    <SolidColorBrush x:Key="SuccessBrush"     Color="#3D5A12"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EDF7D2"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="#8A5206"/>
    <SolidColorBrush x:Key="WarnSoftBrush"    Color="#FDEFD8"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#A4211B"/>
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#FBECEA"/>
    <SolidColorBrush x:Key="NeutralBrush"     Color="#5A5F5E"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#EDEAE4"/>

    <!-- Typography: Segoe UI Variable is native on Windows 11 -->
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyBase">Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeLabel">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizePage">22</sys:Double>

    <!-- Geometry -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
    <sys:Double x:Key="ControlHeight">38</sys:Double>

    <!-- Converters -->
    <h:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <h:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <h:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <h:StatusBadgeBrushConverter x:Key="StatusBadgeFill" Foreground="False"/>
    <h:StatusBadgeBrushConverter x:Key="StatusBadgeText" Foreground="True"/>

</ResourceDictionary>
