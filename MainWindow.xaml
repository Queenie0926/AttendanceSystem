<Window x:Class="Attendance_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staffly — Staff Attendance System" Height="760" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/staffly.ico"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource FontFamilyBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Floating sidebar ── -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="240" Margin="16,16,0,16"
                Background="{StaticResource SidebarBrush}" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#092122" Opacity="0.18" BlurRadius="24" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <DockPanel>
                <!-- Brand -->
                <Grid DockPanel.Dock="Top" Height="72" Margin="19,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{StaticResource LogoMark}" Width="36" Height="36"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Staffly" FontFamily="{StaticResource FontFamilyDisplay}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}"/>
                        <TextBlock Text="Staff Attendance System" FontSize="11"
                                   Foreground="{StaticResource SidebarMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource SidebarBorderBrush}" Margin="16,0,16,12"/>

                <!-- Account + collapse, pinned to bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Border Height="1" Background="{StaticResource SidebarBorderBrush}" Margin="16,0,16,10"/>

                    <Button x:Name="BtnSignOut" Style="{StaticResource NavButtonStyle}" Click="SignOut_Click" ToolTip="Sign out">
                        <StackPanel Orientation="Horizontal">
                            <!-- door + arrow -->
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 8 2 H 3 V 18 H 8 M 13 6 L 17 10 L 13 14 M 17 10 H 7"/>
                            <StackPanel x:Name="AccountText" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sign out"/>
                                <TextBlock x:Name="TxtUserEmail" FontSize="11" Foreground="{StaticResource SidebarMutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnToggleNav" Style="{StaticResource RailToggleStyle}" Margin="18,6,0,0"
                            HorizontalAlignment="Left" Click="ToggleNav_Click" ToolTip="Collapse or expand sidebar">
                        <Path x:Name="ToggleGlyph" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{StaticResource SidebarMutedTextBrush}"
                              Data="M 10 3 L 5 8 L 10 13"/>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="NavHeading" Text="MENU" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SidebarMutedTextBrush}" Margin="24,4,0,8"/>

                    <Button x:Name="BtnEnrollment" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" CommandParameter="Enrollment" ToolTip="Enrollment">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 4 7 A 3.5 3.5 0 1 0 11 7 A 3.5 3.5 0 1 0 4 7 M 1 18 C 1 14.5 3.7 12 7.5 12 C 11.3 12 14 14.5 14 18 M 17 5 V 11 M 14 8 H 20"/>
                            <TextBlock x:Name="LblEnrollment" Text="Enrollment" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnLogs" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" CommandParameter="Logs" ToolTip="Attendance Logs">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 6 3 H 18 M 6 9 H 18 M 6 15 H 18 M 1 3 H 2.5 M 1 9 H 2.5 M 1 15 H 2.5"/>
                            <TextBlock x:Name="LblLogs" Text="Attendance Logs" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReports" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" CommandParameter="Reports" ToolTip="DTR Reports">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 3 1 H 11 L 16 6 V 19 H 3 Z M 11 1 V 6 H 16 M 6 10 H 13 M 6 14 H 13"/>
                            <TextBlock x:Name="LblReports" Text="DTR Reports" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnShift" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" CommandParameter="Shift" ToolTip="Shift Settings">
                        <StackPanel Orientation="Horizontal">
                            <!-- clock -->
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 1 10 A 9 9 0 1 0 19 10 A 9 9 0 1 0 1 10 M 10 5 V 10 L 13.5 12"/>
                            <TextBlock x:Name="LblShift" Text="Shift Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUsers" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" CommandParameter="Users" ToolTip="Users">
                        <StackPanel Orientation="Horizontal">
                            <!-- two people -->
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 3 6 A 3 3 0 1 0 9 6 A 3 3 0 1 0 3 6 M 0 17 C 0 13.5 2.5 11 6 11 C 9.5 11 12 13.5 12 17 M 12.5 3.3 A 3 3 0 1 1 12.5 8.7 M 14 11.2 C 16.5 11.8 18 14 18 17"/>
                            <TextBlock x:Name="LblUsers" Text="Users" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content ── -->
        <!-- No outer ScrollViewer: each view's DataGrid fills the remaining height and scrolls itself. -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="32,32,36,32" MaxWidth="1400"/>
    </Grid>
</Window>
